# Backend environment variables for Render
# Copy to .env for local development (do not commit real secrets)

# Render will inject DATABASE_URL automatically via render.yaml
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# JWT secret for signing auth tokens
JWT_SECRET=replace-with-strong-secret

# CORS origin for frontend
FRONTEND_URL=http://localhost:5173

# Port (Render sets PORT automatically; keep for local dev)
PORT=3001
